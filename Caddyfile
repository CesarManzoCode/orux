# Caddy: estático + TLS + proxy del WebSocket. Una sola cara pública.
#
# ORUX_SITE_ADDRESS = dominio real (ej. orux.midominio.com) y Caddy saca
# el certificado solo. Si queda "localhost", usa su CA local (para probar).
{$ORUX_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Cabeceras de seguridad en TODAS las respuestas — el frontend estático
	# (SPA, landing, panel de operador) no tenía ninguna; la API ya pone las
	# suyas. nosniff corta el MIME-sniffing, SAMEORIGIN permite que la
	# landing embeba el demo del IDE (orux.space → orux.space/app?demo=1)
	# sin abrir a terceros (clickjacking sigue bloqueado), HSTS fuerza HTTPS,
	# y se quita el banner Server. Sin CSP a propósito: una CSP mal puesta
	# rompe el SPA y no se puede verificar desde acá — eso queda para una
	# pasada con el navegador.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# El WebSocket del server va por /ws. Caddy pasa el upgrade solo.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy orux:8765
	}

	# Capa 23: API interna de operador, su propio contenedor desacoplado.
	@api path /api/*
	handle @api {
		reverse_proxy api:8800
	}

	# GitHub OAuth: superficie pública, vive en el MISMO contenedor `api`
	# (es el único proceso HTTP). El callback que se registra en GitHub es
	# https://<dominio>/oauth/github/callback.
	@oauth path /oauth/*
	handle @oauth {
		reverse_proxy api:8800
	}

	# Panel de operador: una página estática (separada del cliente React).
	# Dockerfile.web la copia a /srv/admin/index.html.
	@admin path /admin /admin/*
	handle @admin {
		root * /srv
		rewrite * /admin/index.html
		file_server
	}

	# Capa 23b: la app React vive en /app (Vite base=/app/, dist en
	# /srv/app). Sus assets se piden como /app/assets/... -> /srv/app/...
	# Cualquier /app/* sin archivo -> el index del SPA.
	@app path /app /app/*
	handle @app {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Todo lo demás (incluido el root `/`): la carta de presentación,
	# estática en /srv/index.html. try_files -> /index.html: un path
	# suelto muestra la landing en vez de un 404 feo (no hay routing acá).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
