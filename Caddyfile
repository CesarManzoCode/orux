# Caddy: estático + TLS + proxy del WebSocket. Una sola cara pública.
#
# LAIDEA_SITE_ADDRESS = dominio real (ej. laidea.midominio.com) y Caddy saca
# el certificado solo. Si queda "localhost", usa su CA local (para probar).
{$LAIDEA_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# El WebSocket del server va por /ws. Caddy pasa el upgrade solo.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy laidea:8765
	}

	# Capa 23: API interna de operador, su propio contenedor desacoplado.
	@api path /api/*
	handle @api {
		reverse_proxy api:8800
	}

	# GitHub OAuth: superficie pública, vive en el MISMO contenedor `api`
	# (es el único proceso HTTP). El callback que se registra en GitHub es
	# https://<dominio>/oauth/github/callback.
	@oauth path /oauth/*
	handle @oauth {
		reverse_proxy api:8800
	}

	# Panel de operador: una página estática (separada del cliente React).
	# Dockerfile.web la copia a /srv/admin/index.html.
	@admin path /admin /admin/*
	handle @admin {
		root * /srv
		rewrite * /admin/index.html
		file_server
	}

	# Capa 23b: la app React vive en /app (Vite base=/app/, dist en
	# /srv/app). Sus assets se piden como /app/assets/... -> /srv/app/...
	# Cualquier /app/* sin archivo -> el index del SPA.
	@app path /app /app/*
	handle @app {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Todo lo demás (incluido el root `/`): la carta de presentación,
	# estática en /srv/index.html. try_files -> /index.html: un path
	# suelto muestra la landing en vez de un 404 feo (no hay routing acá).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
