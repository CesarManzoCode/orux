# Caddy: estático + TLS + proxy del WebSocket. Una sola cara pública.
#
# ORUX_SITE_ADDRESS = dominio real (ej. orux.midominio.com) y Caddy saca
# el certificado solo. Si queda "localhost", usa su CA local (para probar).
{$ORUX_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Cabeceras de seguridad en TODAS las respuestas — el frontend estático
	# (SPA, landing, panel de operador) no tenía ninguna; la API ya pone las
	# suyas. nosniff corta el MIME-sniffing, SAMEORIGIN permite que la
	# landing embeba el demo del IDE (orux.space → orux.space/app?demo=1)
	# sin abrir a terceros (clickjacking sigue bloqueado), HSTS fuerza HTTPS,
	# y se quita el banner Server.
	#
	# CSP (BACKEND-AUDIT M-03 fix): por-ruta abajo en cada `handle`. Antes
	# se omitía deliberadamente "porque rompía el SPA"; la encarnación
	# acotada aprovecha que (a) la IDE no tiene `<script>` inline, (b)
	# landing y admin sí (LD+JSON, vanilla), así que el IDE — la pieza más
	# compleja y golosa para XSS — recibe `script-src 'self'` puro mientras
	# que landing/admin se quedan con `'unsafe-inline'` en scripts. Styles
	# inline son inevitables (framer-motion, el `<style>` chico de body bg)
	# así que `style-src` lleva `'unsafe-inline'` en todos los casos.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# El WebSocket del server va por /ws. Caddy pasa el upgrade solo.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy orux:8765
	}

	# Capa 23: API interna de operador, su propio contenedor desacoplado.
	@api path /api/*
	handle @api {
		reverse_proxy api:8800
	}

	# GitHub OAuth: superficie pública, vive en el MISMO contenedor `api`
	# (es el único proceso HTTP). El callback que se registra en GitHub es
	# https://<dominio>/oauth/github/callback.
	@oauth path /oauth/*
	handle @oauth {
		reverse_proxy api:8800
	}

	# Panel de operador: una página estática (separada del cliente React).
	# Dockerfile.web la copia a /srv/admin/index.html.
	@admin path /admin /admin/*
	handle @admin {
		# CSP: admin.html es vanilla con `<script>` y `<style>` inline;
		# permitimos 'unsafe-inline' para los dos. Aún así bloqueamos
		# carga de scripts/CSS/iframes de orígenes externos (la defensa
		# que importa contra una inyección que importe un script remoto).
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		root * /srv
		rewrite * /admin/index.html
		file_server
	}

	# Capa 23b: la app React vive en /app (Vite base=/app/, dist en
	# /srv/app). Sus assets se piden como /app/assets/... -> /srv/app/...
	# Cualquier /app/* sin archivo -> el index del SPA.
	@app path /app /app/*
	handle @app {
		# CSP estricta: el SPA NO tiene `<script>` inline (Vite emite
		# scripts externos) — `script-src 'self'` puro. El `<style>`
		# inline chico de body bg + los inline styles que inyecta
		# framer-motion en runtime requieren `'unsafe-inline'` en styles.
		# Google Fonts: la stylesheet viene de fonts.googleapis.com y los
		# .woff2 de fonts.gstatic.com. `connect-src 'self'` permite el
		# WebSocket en /ws (mismo origen, distinto scheme — los browsers
		# lo aceptan bajo 'self'). `frame-ancestors 'self'` deja que la
		# landing embeba el IDE en el demo (mismo origen).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Todo lo demás (incluido el root `/`): la carta de presentación,
	# estática en /srv/index.html. try_files -> /index.html: un path
	# suelto muestra la landing en vez de un 404 feo (no hay routing acá).
	handle {
		# CSP: la landing tiene `<script type="application/ld+json">`
		# (SEO estructurado) y un `<script>` de detección de idioma
		# tempranero — ambos inline. `'unsafe-inline'` en scripts es el
		# trade-off. Lo demás sigue cerrado contra carga remota.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
