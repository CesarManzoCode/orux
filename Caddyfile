# Caddy: estático + TLS + proxy del WebSocket. Una sola cara pública.
#
# LAIDEA_SITE_ADDRESS = dominio real (ej. laidea.midominio.com) y Caddy saca
# el certificado solo. Si queda "localhost", usa su CA local (para probar).
{$LAIDEA_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# El WebSocket del server va por /ws. Caddy pasa el upgrade solo.
	@ws path /ws /ws/*
	handle @ws {
		reverse_proxy laidea:8765
	}

	# Capa 23: API interna de operador, su propio contenedor desacoplado.
	@api path /api/*
	handle @api {
		reverse_proxy api:8800
	}

	# Panel de operador: una página estática (separada del cliente React).
	# Dockerfile.web la copia a /srv/admin/index.html.
	@admin path /admin /admin/*
	handle @admin {
		root * /srv
		rewrite * /admin/index.html
		file_server
	}

	# Todo lo demás: el cliente React ya compilado (dist/ copiado a /srv
	# por Dockerfile.web). try_files -> index.html: una SPA sirve la misma
	# página para cualquier ruta (hoy no hay router, pero es lo correcto y
	# evita 404 si algún día se agrega navegación).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
