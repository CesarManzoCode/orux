# Copialo a .env y ajustá. docker-compose lo lee solo.

# Dominio real para el deploy -> Caddy saca certificado TLS automático.
# Dejalo en "localhost" para probar local (el navegador avisará del cert).
LAIDEA_SITE_ADDRESS=localhost

# Capa 23: token de la API/consola de OPERADOR (vos), en /api/v1 y /admin.
# Es un secreto largo y aleatorio (p.ej. `openssl rand -hex 32`). VACÍO o
# sin setear = la API queda CERRADA (503): nunca se expone sin querer.
# Distinto del admin-de-equipo; esto es superadmin de plataforma.
LAIDEA_ADMIN_TOKEN=
